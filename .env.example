NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: the origin your app is served at — protocol + domain ONLY,
# no path (e.g. https://yourname.github.io, not .../bar-inventory-app).
# Next.js already adds the GitHub Pages sub-path itself; including it here
# too would double it up. Used so shared links show the right preview
# image/title instead of a broken localhost one. GitHub Pages deploys set
# this automatically — only needed for other hosts.
NEXT_PUBLIC_SITE_URL=